# Copy to .env (gitignored) and fill in. Never commit real values.
# In GitHub Actions these come from repository secrets and variables instead.

# feed_map.xml: lists every feed XML and its URL
FEED_MAP_URL=
# Jobiqo's Appcast export (what is live on the board); same URL as JPD's t00_feed_registry 'appcast' row
JOBIQO_EXPORT_URL=

BQ_PROJECT=site-monitoring-421401
# feed_health_dev for local runs; only the scheduled Action writes to feed_health
BQ_DATASET=feed_health_dev
BQ_LOCATION=EU
# Path to the collector service-account key (relative to the project root)
GOOGLE_APPLICATION_CREDENTIALS=.Feed-health-collector_ServiceKey.json
